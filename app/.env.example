# Copier en .env.local (Vite) ou exporter avant le build iOS.
#
# App Store — URL publique HTTPS de TON serveur (pas Base44) :
#   VITE_API_URL=https://api.mondomaine.fr

VITE_API_URL=http://127.0.0.1:8787
VITE_SELF_HOSTED=true

# --- Serveur ---
# HOST=0.0.0.0
# PORT=8787
# DATA_DIR=./data
# FEELGOOD_SEED=0
# CORS_ORIGIN=*
# PUBLIC_URL=https://api.mondomaine.fr
# APP_PUBLIC_URL=https://app.mondomaine.fr
# JWT_SECRET=change-moi
# DATABASE_URL=postgres://feelgood:feelgood@127.0.0.1:5432/feelgood

# Connexion Google (console.cloud.google.com → Identifiants OAuth)
# URI de redirection : https://api.mondomaine.fr/api/apps/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Connexion Facebook (developers.facebook.com)
# URI de redirection : https://api.mondomaine.fr/api/apps/auth/callback/facebook
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Connexion Apple (obligatoire sur l’App Store si Google/Facebook sont actifs)
# URI de redirection : https://api.mondomaine.fr/api/apps/auth/callback/apple
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# E-mails d’invitation parent (optionnel, sinon l’invitation est juste enregistrée)
# RESEND_API_KEY=
# MAIL_FROM=FeelGood <noreply@mondomaine.fr>

# Geofabrik (qualité KPI) — même valeur que le secret GitHub GEOSERVICE_KEY
# FEELGOOD_SERVICE_KEY=
# GEOFABRIK_SEED_GRAND_EST=1
