# Copier en .env.local puis ajuster.
#
# Backend Base44 heberge. Les appels /api sont proxyfies vers cette adresse par
# @base44/vite-plugin, et l'application demande une session Base44 : sans
# compte connecte, l'API repond 403 auth_required.
VITE_BASE44_APP_ID=6a0378f1a863c7c3ea00c725
VITE_BASE44_APP_BASE_URL=https://feel-good-drive.base44.app

# Pour travailler sans compte Base44, viser le backend de developpement du
# depot (voir app/devserver/README.md) :
#
#   npm run dev:local
#
# qui equivaut a VITE_BASE44_APP_BASE_URL=http://127.0.0.1:8787
