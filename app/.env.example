# Copier en .env.local (Vite) ou exporter avant le build iOS.
#
# App Store — URL publique HTTPS de TON serveur (pas Base44) :
#   VITE_API_URL=https://api.mondomaine.fr
#
# Dev local (API + Vite) :
#   npm run dev:local

VITE_API_URL=http://127.0.0.1:8787
VITE_SELF_HOSTED=true

# Serveur (docker compose / npm start) — decommenter au besoin :
# HOST=0.0.0.0
# PORT=8787
# DATA_DIR=./data
# FEELGOOD_SEED=0
# CORS_ORIGIN=*
# FEELGOOD_USER_ID=user-local-1
# FEELGOOD_USER_EMAIL=moi@localhost
# FEELGOOD_USER_NAME=Conducteur
