{
  "name": "Retry Pending OSM",
  "description": "Re-tente l'analyse OSM des trajets en attente (pending_osm) toutes les 10 minutes",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "retry_pending_osm",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "retry_pending": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "retryPendingOsm"
          },
          "then": "end",
          "x-base44": {
            "title": "Re-tenter les trajets OSM en attente",
            "description": "Toutes les 10 minutes"
          }
        }
      }
    ]
  }
}